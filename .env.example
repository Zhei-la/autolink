# Supabase (Step 2에서 받을 값들 — 지금은 빈 칸으로 두기)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 사이트 URL (배포된 주소)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 짧은 공개 주소 호스트 (예: link.byranmedia.com). 비워두면 /p/<아이디> 주소 사용
NEXT_PUBLIC_PUBLIC_HOST=

# 방문자 해시 솔트 (아무 긴 문자열; 바꾸면 순방문자 집계가 리셋됨)
TRACKING_SALT=

# 쇼츠 리믹서 → /api/remix-push 호출 시 사용하는 비밀키 (비어 있으면 엔드포인트 비활성)
REMIX_PUSH_SECRET=
